rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : "";
    }

    function isSharedOwner(projectId) {
      return signedIn()
        && get(/databases/$(database)/documents/sharedProjects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function hasSharedInvite(projectId) {
      return signedIn()
        && authEmail() != ""
        && exists(/databases/$(database)/documents/shareInvites/$(authEmail())/projects/$(projectId));
    }

    function hasSharedMember(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sharedProjects/$(projectId)/members/$(request.auth.uid));
    }

    function canAccessShared(projectId) {
      return isSharedOwner(projectId) || hasSharedInvite(projectId) || hasSharedMember(projectId);
    }

    match /users/{userId}/projects/{projectId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /sharedProjects/{projectId} {
      allow get, list:
        if signedIn()
        && (resource.data.ownerId == request.auth.uid || hasSharedInvite(projectId) || hasSharedMember(projectId));

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update:
        if canAccessShared(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          resource.data.ownerId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['updatedAt', 'updatedBy', 'data'])
        );

      allow delete:
        if signedIn() && resource.data.ownerId == request.auth.uid;

      match /presence/{presenceUserId} {
        allow read:
          if canAccessShared(projectId);

        allow create, update:
          if canAccessShared(projectId)
          && request.auth.uid == presenceUserId;

        allow delete:
          if signedIn()
          && (request.auth.uid == presenceUserId || isSharedOwner(projectId));
      }

      match /nodePositions/{nodeId} {
        allow read:
          if canAccessShared(projectId);

        allow create, update:
          if canAccessShared(projectId)
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete:
          if canAccessShared(projectId);
      }

      match /members/{memberId} {
        allow read:
          if canAccessShared(projectId);

        allow create:
          if signedIn()
          && (
            isSharedOwner(projectId)
            || (
              memberId == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && (
                hasSharedInvite(projectId)
                || (
                  request.resource.data.joinCode != ""
                  && request.resource.data.joinCode ==
                    get(/databases/$(database)/documents/sharedProjects/$(projectId)).data.joinCode
                )
              )
            )
          );

        allow update:
          if signedIn()
          && (
            isSharedOwner(projectId)
            || (
              memberId == request.auth.uid
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
            )
          );

        allow delete:
          if signedIn()
          && (isSharedOwner(projectId) || memberId == request.auth.uid);
      }

      match /kicks/{kickUserId} {
        allow read:
          if signedIn()
          && (request.auth.uid == kickUserId || isSharedOwner(projectId));

        allow create, update:
          if isSharedOwner(projectId)
          && request.resource.data.uid == kickUserId;

        allow delete:
          if signedIn()
          && (isSharedOwner(projectId) || request.auth.uid == kickUserId);
      }

      match /invites/{inviteId} {
        allow read, create, update, delete:
          if isSharedOwner(projectId);
      }
    }

    match /shareCodes/{code} {
      allow get:
        if signedIn();

      allow list:
        if false;

      allow create:
        if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isSharedOwner(request.resource.data.projectId);

      allow update, delete:
        if signedIn()
        && resource.data.ownerId == request.auth.uid
        && isSharedOwner(resource.data.projectId);
    }

    match /shareInvites/{inviteEmail}/projects/{projectId} {
      allow read:
        if signedIn() && authEmail() == inviteEmail;

      allow create, update:
        if isSharedOwner(projectId)
        || (
          signedIn()
          && authEmail() == inviteEmail
          && hasSharedMember(projectId)
          && request.resource.data.projectId == projectId
        );

      allow delete:
        if isSharedOwner(projectId)
        || (signedIn() && authEmail() == inviteEmail);
    }
  }
}
